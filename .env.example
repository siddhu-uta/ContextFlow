# ──────────────────────────────────────────────────────────────────
# ContextFlow — required environment variables
#
# Copy this file to .env and fill in real values before running.
# NEVER commit a .env file with real secrets to version control.
# ──────────────────────────────────────────────────────────────────

# ── JWT ────────────────────────────────────────────────────────────
# REQUIRED in production. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-strong-random-secret-at-least-32-chars

# ── Database ───────────────────────────────────────────────────────
DB_USERNAME=contextflow
DB_PASSWORD=replace-me-with-a-strong-password

# ── Redis ──────────────────────────────────────────────────────────
# Leave blank to disable Redis authentication (local dev only).
# Set to a strong password in staging/production.
REDIS_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost in dev. Set to your actual domain(s) in prod.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ── AWS / S3 ───────────────────────────────────────────────────────
# LocalStack uses "test"/"test" for local dev — replace for real AWS.
INGESTION_S3_ACCESS_KEY=your-aws-access-key-id
INGESTION_S3_SECRET_KEY=your-aws-secret-access-key

# ── LLM ───────────────────────────────────────────────────────────
# Set LLM_MODE=openai and provide a key to use real GPT responses.
# Defaults to "mock" (streaming stub) when not set.
LLM_MODE=openai
OPENAI_API_KEY=sk-...
